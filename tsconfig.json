{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "classifier.js",
    "email.js",
    "shopify.js",
    "seguimiento.js",
    "logger.js",
    "metricas.js",
    "index.js",
    "verify-env.js",
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "coverage",
    "tests"
  ]
}
